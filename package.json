  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": "24.21.0"
  },
  "private": true,
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild@0.28.2": true
  }
