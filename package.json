{
  "name": "memtextual",
  "version": "0.8.0",
  "description": "Local-first persistent memory for AI agents",
  "license": "UNLICENSED",
  "main": "dist/src/index.js",
  "bin": {
    "memtextual-mcp": "dist/src/mcp/stdio.js",
    "memtextual-migrate": "dist/src/cli/migrate.js",
    "memtextual-safeguard": "dist/src/cli/safeguard.js",
    "memtextual-privacy": "dist/src/cli/privacy.js",
    "memtextual-review": "dist/src/cli/review.js",
    "memtextual-policy": "dist/src/cli/policy.js",
    "memtextual-continuity-setup": "dist/src/cli/continuity-setup.js",
    "memtextual-continuity-acceptance": "dist/src/cli/continuity-acceptance.js",
    "memtextual-continuity-upgrade": "dist/src/cli/continuity-upgrade.js",
    "memtextual-continuity-release": "dist/src/cli/continuity-release-validation.js",
    "memtextual-continuity": "dist/src/cli/continuity-console.js",
    "memtextual-windows-host": "dist/src/cli/windows-host.js",
    "memtextual-windows-host-validation": "dist/src/cli/windows-elevated-host-validation.js",
    "memtextual-windows-bundle": "dist/src/cli/windows-bundle.js"
  },
  "scripts": {
    "test": "node --import tsx --test test/**/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mcp": "tsx src/mcp/stdio.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "review": "tsx src/cli/review.ts",
    "policy": "tsx src/cli/policy.ts",
    "continuity-setup": "tsx src/cli/continuity-setup.ts",
    "continuity-acceptance": "tsx src/cli/continuity-acceptance.ts",
    "continuity-upgrade": "tsx src/cli/continuity-upgrade.ts",
    "continuity-release": "tsx src/cli/continuity-release-validation.ts",
    "safeguard": "tsx src/cli/safeguard.ts",
    "privacy": "tsx src/cli/privacy.ts",
    "continuity": "tsx src/cli/continuity-console.ts",
    "windows-host": "tsx src/cli/windows-host.ts",
    "windows-host-validation": "tsx src/cli/windows-elevated-host-validation.ts",
    "windows-bundle": "tsx src/cli/windows-bundle.ts",
    "pretest": "node scripts/check-node.mjs",
    "prebuild": "node scripts/check-node.mjs"
  },
  "dependencies": {
    "@azure/identity": "4.14.0",
    "@azure/storage-blob": "12.34.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "better-sqlite3": "13.0.3",
    "zod": "^4.6.5"
